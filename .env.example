# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NOTE: a real key was previously committed here and has been removed —
# rotate that key if it is still active.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://recura-rosy.vercel.app/"

# VITE_API_URL: Recura server API base (Vite exposed, baked at build time).
# Leave EMPTY when the SPA is served by the Recura server itself (same-origin).
# Set it to the hosted Recura server URL when the SPA is hosted separately
# (e.g. this Vercel demo talking to a Render/Railway server):
#   VITE_API_URL="https://recura-test.onrender.com"
# The server must then list this SPA's origin in RECURA_CORS_ORIGINS.

# RECURA_CORS_ORIGINS (server env): comma-separated SPA origins allowed to call
# the Recura server's API cross-origin. Empty = same-origin only (default).
#   RECURA_CORS_ORIGINS="https://recura-rosy.vercel.app"
# Cross-origin mode also switches the CSRF cookie to SameSite=None; Secure, so
# the server must be served over HTTPS.

# VITE_ENCRYPTION_KEY: 32+ character secret used to derive the AES-256 key that
# encrypts account passwords / PINs at rest. Set this to a fixed value so
# encrypted credentials survive across browsers, devices, and page reloads:
#   VITE_ENCRYPTION_KEY="change-me-to-a-long-random-secret-string"
# If left empty, Recura generates and persists a key in the browser's
# localStorage (works across reloads in the same browser, but not across
# browsers/devices). SECURITY: never commit the real key to version control.

# Supabase database configuration (Vite exposed)
# SECURITY: Replace with YOUR OWN Supabase project credentials.
# Never commit real credentials to version control.
VITE_SUPABASE_URL="https://ybwiytzjfggwfjqozkpp.supabase.co"
