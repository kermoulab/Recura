# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Supabase database configuration (Vite exposed)
# Before running the app:
#   1. Go to your Supabase project → SQL Editor
#   2. Run scripts/recura_full_schema.sql (creates all tables + demo data)
#   3. Update the values below with your Supabase project credentials
#   4. Copy this file to .env (gitignored)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
